SERVER_PORT=8089
SERVER_ENV=development

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=siaga_user
POSTGRES_PASSWORD=siaga_pass
POSTGRES_DB=siaga_db
POSTGRES_SSLMODE=disable

# Public base URL of the web app — used to build links inside notifications.
APP_BASE_URL=http://localhost:5182

# Path to the built siaga-web dist for single-origin serving (prod: /app/web).
# Leave blank in local dev (run the Vite dev server instead).
WEB_DIST=

# Email notifications (SMTP). Leave blank to disable email delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# SMS + voice-call notifications (Twilio). Leave blank to disable.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Optional org-wide Slack Incoming Webhook fallback (per-service webhook wins).
SLACK_DEFAULT_WEBHOOK_URL=
